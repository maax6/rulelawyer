# ---------------------------------------------------------------------------
# Contenu tiers : ce dépôt ne contient AUCUN livre de règles.
# Ces règles passent avant tout le reste, volontairement.
# ---------------------------------------------------------------------------
*.pdf
*.epub
*.mobi
*.cbz
*.cbr
data/
books/

# Sauf les fixtures explicitement redistribuables (OGL / Creative Commons),
# documentées dans fixtures/SOURCES.md.
!fixtures/**/*.pdf

# Artefacts d'ingestion : dérivés d'une œuvre protégée, donc jamais partagés.
*.jsonl
chunks/
qdrant_storage/
.cache/
out/
reports/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
uv.lock.bak

# Secrets et identifiants locaux (meme dans les sous-dossiers)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
.aws/
.ssh/
.netrc
.npmrc
.pypirc
credentials.json
secrets.json
secrets.yaml
secrets.yml

# OS / éditeurs
.DS_Store
.idea/
.vscode/
